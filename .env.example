# Copy to .env and fill in. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-5-nano
# Prices in USD per 1M tokens, used for the cost ledger. Check https://openai.com/api/pricing
LLM_INPUT_PRICE_PER_M=0.05
LLM_OUTPUT_PRICE_PER_M=0.40
EMBEDDING_PRICE_PER_M=0.02

# openai = text-embedding-3-small (paid, ~$0.02/1M tokens)
# local  = BAAI/bge-small-en-v1.5 via fastembed (free, CPU)
# fake   = deterministic hash vectors (tests only, no meaning)
EMBEDDINGS_PROVIDER=openai
# openai | fake   (fake = canned answers, for tests/offline demos)
LLM_PROVIDER=openai
MODERATION_ENABLED=true
RERANK_ENABLED=true
# Cross-encoder relevance cutoff (tune with `rag eval`)
RERANK_MIN_SCORE=-5.0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
# No Docker? Uncomment to run Qdrant embedded in-process (single process at a time):
# QDRANT_PATH=var/qdrant_local

# --- Cost controls ---
DAILY_BUDGET_USD=0.50
MAX_OUTPUT_TOKENS=600

# --- API auth: comma separated key:role pairs. Roles: employee, hr, admin ---
# Generate keys with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEYS=dev-employee-key:employee,dev-hr-key:hr,dev-admin-key:admin
RATE_LIMIT_PER_MINUTE=20

# Retrieval tuning
# EXCLUDE_FLAGGED_CHUNKS=true   # keep quarantined (likely-injection) chunks out of retrieval
# CHUNK_TOKENS=450              # changing chunking requires `rag reindex`
